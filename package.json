{
  "name": "dsh-boot-animation",
  "version": "1.1.1",
  "description": "打开新对话（或你钉住的会话）时，铺满窗口播放一段片头动画；入场动画与工作区壁纸各自独立选段（壁纸为静帧，或只循环片尾 N 秒的动态）。Open a new (or a pinned) DSH conversation and a full-frame intro plays; the intro and the workspace wallpaper are picked independently, as a still or as a looping tail.",
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/types/index.d.ts",
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "README.en.md",
    "LICENSE"
  ],
  "license": "BSD-3-Clause",
  "author": "NativeDog1",
  "contributors": [
    "mu915275-cmd (workspace-skin fork)"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mu915275-cmd/dsh-boot-animation.git"
  },
  "homepage": "https://github.com/mu915275-cmd/dsh-boot-animation#readme",
  "bugs": {
    "url": "https://github.com/mu915275-cmd/dsh-boot-animation/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "cordis",
    "boot-animation",
    "intro",
    "splash",
    "startup"
  ],
  "engines": {
    "node": ">=20"
  },
  "peerDependencies": {
    "react": "^18.2.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "tsdown": "^0.22.14",
    "typescript": "^5.9.0"
  },
  "scripts": {
    "build": "bash scripts/build.sh",
    "build:client": "node scripts/check-css-template.mjs && tsdown",
    "embed-clips": "node scripts/embed-clips.mjs",
    "check": "node scripts/check-css-template.mjs && node scripts/verify-routes.mjs",
    "verify:routes": "node scripts/verify-routes.mjs",
    "verify:letterbox": "node scripts/verify-letterbox.mjs"
  },
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-session",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ],
      "platform": "web"
    },
    "engines": {
      "dsh": ">=0.1.5-rc.1"
    }
  }
}
