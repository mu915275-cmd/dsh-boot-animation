+  // slow frame): restart the window by hand instead of staying frozen.
+  video.addEventListener('ended', () => {
+    clampToWindow(video)
+    const attempt = video.play()
+    if (attempt !== undefined && typeof attempt.catch === 'function') attempt.catch(() => {})
+  })
